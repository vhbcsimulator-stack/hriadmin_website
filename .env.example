# Admin app — Supabase. Copy to admin/.env and fill in from
# Supabase Dashboard > Project Settings > API.
#
# The admin keeps its own .env so it stays deployable independently of the
# public site. Both apps normally point at the same project.
#
# Leave blank to keep using content/site-content.json and the temporary
# hard-coded login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secret, used solely by `npm run seed:content`. It bypasses
# row-level security — it must never be given a VITE_ prefix, because Vite
# inlines every VITE_ variable into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
